# Settings a public caller depends on; no secrets. See deploy/public-enforce.conf.
# GET /aegis/readiness must then report ready=true, enforcement=enforce,
# audit_prompt_text=false, backend_redirects=false, cancel_on_disconnect=true.
ENFORCEMENT_MODE=enforce
# Audit rows keep fixed verdicts, scores and latency, never the visitor's text.
REDACT_PROMPTS_IN_LOGS=true
AUDIT_RETENTION_DAYS=7
INPUT_GUARD_TIMEOUT=5
# Stream from llama-server internally so a caller disconnect stops generation
# (non-streamed requests are often finished anyway). Replies stay non-streaming.
BACKEND_STREAM=true
# DEBUG would log SQL parameters and request details; keep INFO or above.
LOG_LEVEL=INFO
