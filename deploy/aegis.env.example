# Aegis-ML production settings for guarding a public app's LLM calls.
# Copied to ~/.config/aegis/aegis.env by deploy/install.sh (chmod 600).

# ── Listen on loopback only; only the app on this host calls Aegis ──
HOST=127.0.0.1
PORT=8000
WORKERS=1

# ── The LLM being protected ──
BACKEND_URL=http://127.0.0.1:8080/v1/chat/completions
BACKEND_TIMEOUT=60

# ── Classifier: sklearn fast path, ambiguous prompts to mDeBERTa INT8 on CPU ──
CLASSIFIER_TYPE=cascade2
ONNX2_USE_INT8=true
SKLEARN_MODEL_PATH=models/sklearn_classifier.joblib
ONNX2_MODEL_PATH=models/hf2_classifier_onnx

# ── The app writes the system prompt itself; only user messages are untrusted ──
SCAN_ROLES=user

# ── Start in monitor mode; switch to enforce after reviewing real traffic ──
ENFORCEMENT_MODE=monitor

# ── Admin endpoints (/audit/logs, /metrics). install.sh generates a token. ──
ADMIN_TOKEN=
CORS_ALLOW_ORIGINS=

# ── Audit log: keep visitor questions for review, delete after 30 days ──
DATABASE_URL=sqlite+aiosqlite:///./logs/aegis_audit.db
REDACT_PROMPTS_IN_LOGS=false
AUDIT_RETENTION_DAYS=30

# Every request comes from the app over loopback, so this is a global cap;
# the app enforces per-visitor limits itself.
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
